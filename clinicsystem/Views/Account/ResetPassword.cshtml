@model clinicsystem.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="logo-mark">🔒</div>
        <h2 style="text-align:center; margin-bottom:1rem;">إعادة تعيين كلمة المرور</h2>

        <form class="form-grid" asp-action="ResetPassword"
              asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            @* Hidden fields carry the token and email through the POST *@
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="All"
                 class="footer-note"
                 style="color:#e74c3c; margin-bottom:.5rem;"></div>

            <label asp-for="NewPassword">كلمة المرور الجديدة</label>
            <input asp-for="NewPassword" class="form-control" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"
                  class="footer-note" style="color:#e74c3c;"></span>

            <label asp-for="ConfirmPassword">تأكيد كلمة المرور</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"
                  class="footer-note" style="color:#e74c3c;"></span>

            <button class="btn btn-primary" type="submit">تعيين كلمة المرور</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
