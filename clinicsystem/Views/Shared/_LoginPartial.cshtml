@using Microsoft.AspNetCore.Identity
@inject SignInManager<clinicsystem.Models.User> SignInManager
@inject UserManager<clinicsystem.Models.User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    <div style="display:flex; align-items:center; gap:1rem; padding:.5rem 1rem;
                    font-size:.875rem; border-top:1px solid var(--border,#333); margin-top:auto;">
        <span class="muted">👤 @(currentUser?.FullName ?? User.Identity?.Name)</span>
        <a class="btn btn-outline" style="padding:.25rem .75rem; font-size:.8rem;"
           asp-controller="Account" asp-action="Logout">
            تسجيل الخروج
        </a>
    </div>
}
else
{
    <div style="display:flex; gap:.75rem; padding:.5rem 1rem;
                    border-top:1px solid var(--border,#333); margin-top:auto;">
        <a class="btn btn-outline" style="flex:1; text-align:center; font-size:.85rem;"
           asp-controller="Account" asp-action="Login">دخول</a>
        <a class="btn btn-primary" style="flex:1; text-align:center; font-size:.85rem;"
           asp-controller="Account" asp-action="Register">تسجيل</a>
    </div>
}