@model clinicsystem.ViewModels.UserViewModel
@{
    ViewData["Title"] = "الملف الشخصي";
    ViewData["ActivePage"] = "Details";
}
@section Sidebar {
    @await Html.PartialAsync("_PatientSidebar")
}

<div class="topbar">
    <div>
        <h2>الملف الشخصي</h2>
        <p class="muted">بيانات حسابك في النظام.</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline" asp-controller="Patient" asp-action="Dashboard">
            لوحة المستخدم
        </a>
        <a class="btn btn-outline" asp-controller="Account" asp-action="Logout">
            Log out
        </a>
    </div>
</div>

<section class="grid-2">
    <div class="card">
        <h3>بيانات المستخدم</h3>
        <p><strong>الاسم:</strong> @Model.FullName</p>
        <p><strong>الهاتف:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</p>
        <p><strong>البريد:</strong> @Model.Email</p>
    </div>
    <div class="card">
        <h3>Doctor's details</h3>
        <p><strong>الطبيب:</strong> د. جون إبراهيم</p>
        <p><strong>التخصص:</strong> باطنة</p>
        <p><strong>أيام المتابعة:</strong> الثلاثاء والخميس</p>
        <p><strong>الوقت:</strong> 10:00 ص - 12:00 م</p>
    </div>
</section>

<section class="card" style="margin-top:1rem;">
    <h3>Reservation details</h3>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>الطبيب</th>
                    <th>اليوم</th>
                    <th>الوقت</th>
                    <th>المصدر</th>
                </tr>
            </thead>
            <tbody id="userReservationHistory"></tbody>
        </table>
    </div>
</section>