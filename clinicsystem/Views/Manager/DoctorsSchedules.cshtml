@{
    ViewData["Title"] = "جداول الأطباء";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid py-4" style="background-color: #f4f6f9; min-height: 100vh; direction: rtl;">

    <div class="p-4 text-white mb-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e3a8a, #2563eb); border-radius: 12px;">
        <div>
            <h3 class="fw-bold m-0">جداول الأطباء</h3>
            <small class="text-white-50">إدارة مواعيد العمل الخاصة بكل طبيب</small>
        </div>
        <a href="/Manager/DashBoard" class="btn btn-light text-primary fw-bold" style="border-radius: 8px; text-decoration: none;">
            <i class="fas fa-arrow-right ms-1"></i> الرجوع للخلف
        </a>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <h5 class="fw-bold mb-3"><i class="fas fa-plus-circle text-primary me-1"></i> إضافة ميعاد جديد</h5>
                <form id="scheduleForm" onsubmit="saveDoctorSchedule(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">اختر الطبيب</label>
                        <select class="form-select" id="scheduleDoctorSelect" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">اليوم</label>
                        <select class="form-select" id="scheduleDay" required>
                            <option value="">اختر اليوم</option>
                            <option value="السبت">السبت</option>
                            <option value="الأحد">الأحد</option>
                            <option value="الإثنين">الإثنين</option>
                            <option value="الثلاثاء">الثلاثاء</option>
                            <option value="الأربعاء">الأربعاء</option>
                            <option value="الخميس">الخميس</option>
                            <option value="الجمعة">الجمعة</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">من الساعة</label>
                        <input type="time" class="form-control" id="scheduleStartTime" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">إلى الساعة</label>
                        <input type="time" class="form-control" id="scheduleEndTime" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">حفظ الميعاد</button>
                </form>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 16px;">
                <h5 class="fw-bold mb-3"><i class="fas fa-calendar-alt text-success me-1"></i> المواعيد المسجلة</h5>
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>اسم الطبيب</th>
                                <th>اليوم</th>
                                <th>من</th>
                                <th>إلى</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="schedulesTableBody">
                            <tr><td colspan="5" class="text-center text-muted">جاري تحميل البيانات...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/script.js"></script>
}