@model List<clinicsystem.ViewModels.DoctorListItemVM>
@{
    ViewData["Title"] = "جداول الأطباء";
}
<div class="container page-pad">
    <div class="topbar">
        <h2>جداول جميع الأطباء</h2>
        <div class="actions">
            <button class="btn btn-outline" onclick="goBackFromDoctorsSchedules()">الرجوع للخلف</button>
        </div>
    </div>

    @if (TempData["Ok"] != null)   { <p class="footer-note" style="color:#39d98a;">@TempData["Ok"]</p> }
    @if (TempData["Error"] != null){ <p class="footer-note" style="color:#ff6b6b;">@TempData["Error"]</p> }

    <section class="card">
        <p class="muted">كل طبيب له عدد أيام محدد في الأسبوع وساعات محددة داخل اليوم.</p>
        <div class="actions" style="margin-top:.8rem;">
            <a class="btn btn-primary" href="/add-schedule">إضافة جدول جديد</a>
            <a class="btn btn-outline" href="/edit-schedule">تعديل جدول طبيب</a>
            <a class="btn btn-outline" asp-controller="Specialities" asp-action="Index">إدارة التخصصات</a>
        </div>

        <div class="grid-2" style="margin-top: .8rem;">
            @if (!Model.Any())
            {
                <p class="muted">لا يوجد أطباء مسجلون بعد. ابدأ بإضافة جدول جديد.</p>
            }
            @foreach (var d in Model)
            {
                <div class="card">
                    <h4>@d.Name</h4>
                    <p class="muted">@d.Speciality</p>
                    <ul class="list">
                        @foreach (var day in d.Days)
                        {
                            <li>@day.WeekDay: @day.From - @day.To (@day.Slots.Count موعد)</li>
                        }
                        @if (!d.Days.Any())
                        {
                            <li class="muted">لا توجد أيام مجدولة.</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>
