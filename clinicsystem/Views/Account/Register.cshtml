@model clinicsystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="logo-mark">🩺</div>
        <h2 style="text-align:center; margin-bottom:1rem;">إنشاء حساب مستخدم</h2>

        <form class="form-grid" asp-action="Register" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="footer-note" style="color:#e74c3c; margin-bottom:.5rem;"></div>

            <label asp-for="FirstName">الاسم الأول</label>
            <input asp-for="FirstName" class="form-control" type="text"
                   placeholder="محمد" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="footer-note" style="color:#e74c3c;"></span>

            <label asp-for="LastName">اسم العائلة</label>
            <input asp-for="LastName" class="form-control" type="text"
                   placeholder="أحمد" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="footer-note" style="color:#e74c3c;"></span>

            <label asp-for="Phone">رقم الهاتف</label>
            <input asp-for="Phone" class="form-control" type="text"
                   placeholder="01098765432" autocomplete="tel" />
            <span asp-validation-for="Phone" class="footer-note" style="color:#e74c3c;"></span>

            <label asp-for="Email">البريد الإلكتروني</label>
            <input asp-for="Email" class="form-control" type="email"
                   placeholder="example@gmail.com" autocomplete="email" />
            <span asp-validation-for="Email" class="footer-note" style="color:#e74c3c;"></span>

            <label asp-for="Password">كلمة المرور</label>
            <input asp-for="Password" class="form-control" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="Password" class="footer-note" style="color:#e74c3c;"></span>

            <label asp-for="ConfirmPassword">تأكيد كلمة المرور</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="footer-note" style="color:#e74c3c;"></span>

            <label class="muted">الدور</label>
            <input class="form-control" type="text" value="مريض (Patient)" disabled />

            <button class="btn btn-primary" type="submit">إنشاء الحساب</button>
        </form>

        <p style="text-align:center; margin-top:1rem;">
            لديك حساب؟
            <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}