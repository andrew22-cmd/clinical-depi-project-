@{
    ViewData["Title"] = "لوحة الطبيب";
}
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">🩺 <span>لوحة الطبيب</span></div>
      <ul class="nav-list">
        <li><a class="nav-link active" href="/doctor-dashboard">الجدول</a></li>
        <li><a class="nav-link" href="/doctor-patient-details">تفاصيل المرضى</a></li>
      </ul>
    </aside>

    <main class="main">
      <div class="topbar">
        <div>
          <h2 id="doctorNameHeader">-</h2>
          <p id="doctorSummaryHeader" class="muted">-</p>
        </div>
      </div>

      <section class="grid-3">
        <div class="card">
          <h4>إجمالي مواعيد اليوم</h4>
          <div id="doctorTodayAppointments" class="stat">0</div>
        </div>
        <div class="card">
          <h4>الحضور المؤكد</h4>
          <div id="doctorConfirmedAppointments" class="stat">0</div>
        </div>
        <div class="card">
          <h4>الوقت المتاح</h4>
          <div id="doctorAvailableTime" class="stat">0h</div>
        </div>
      </section>

      <section class="card" style="margin-top:1rem;">
        <h3>الجدول الأسبوعي (شكل تقويمي)</h3>
        <div id="doctorCalendarGrid" class="calendar-grid" style="margin-top: .8rem;"></div>
      </section>

      <section class="card" style="margin-top:1rem;">
        <h3>قائمة المواعيد</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>المريض</th>
                <th>اليوم</th>
                <th>الوقت</th>
                <th>الحالة</th>
              </tr>
            </thead>
            <tbody id="doctorAppointmentsBody"></tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

