@model clinicsystem.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نسيت كلمة المرور</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-wrapper">

        <div class="auth-card">

            <div class="logo-mark">🔑</div>

            <h2 style="text-align:center; margin-bottom:0.5rem;">
                نسيت كلمة المرور؟
            </h2>

            <p class="muted" style="text-align:center; margin-bottom:1.5rem;">
                أدخل بريدك الإلكتروني وسنرسل لك رابط لإعادة تعيين كلمة المرور.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" style="margin-bottom: 1rem;">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  class="form-grid">

                @Html.AntiForgeryToken()

                <label asp-for="Email">البريد الإلكتروني</label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="example@gmail.com"
                       type="email" />

                <span asp-validation-for="Email" class="text-danger"></span>

                <button class="btn btn-primary" type="submit" style="margin-top: 0.5rem;">
                    إرسال رابط إعادة التعيين
                </button>

            </form>

            <p style="text-align:center; margin-top:1.5rem;">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="text-decoration-none">
                    ← العودة لتسجيل الدخول
                </a>
            </p>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ToastrScripts" />

</body>
</html>
