@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تأكيد الحجز</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card" style="text-align:center;">
            <div class="logo-mark" style="font-size: 3rem;">📧</div>
            <h2>تم إرسال البريد الإلكتروني بنجاح</h2>
            <p class="muted">تم إرسال إشعار التأكيد للحجز إلى بريدك الإلكتروني.</p>

            <div class="card" style="text-align:right; margin-top:1rem;">
                <h4>ملخص الرسالة</h4>
                <p class="muted">تم تأكيد الموعد وسيصلك تذكير قبل وقت الحجز.</p>
            </div>

            <div class="actions" style="justify-content:center; margin-top:1rem;">
                <button class="btn btn-primary" onclick="goTo('/Patient/DashBoard')">العودة للوحة المستخدم</button>
            </div>
        </div>
    </div>
    <script src="~/js/script.js" asp-append-version="true"></script>
    <partial name="_ToastrScripts" />
</body>
</html>