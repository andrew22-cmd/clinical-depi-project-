@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medical Clinic Reservation System</title>
    <link rel="StyleSheet" href="~/css/StyleSheet.css" asp-append-version="true">
</head>
<body>
    <div class="hero-wrapper">
        <section class="hero">
            <div class="logo-mark">🩺</div>
            <h1>Medical Clinic Reservation System</h1>
            <p>نظام حديث لإدارة حجوزات العيادة الطبية للمستخدمين والأطباء والسكرتارية والإدارة.</p>

            <div class="grid-2" style="margin: 1rem 0 1.2rem;">
                <div class="card">
                    <h3>حجز أسرع</h3>
                    <p class="muted">اختر الطبيب وستظهر مواعيده الفعلية حسب الأيام والساعات المتاحة فقط.</p>
                </div>
                <div class="card">
                    <h3>متابعة أسهل</h3>
                    <p class="muted">لوحات تحكم لكل دور مع واجهة داكنة حديثة ومتجاوبة.</p>
                </div>
            </div>

            <div class="actions" style="justify-content:center; margin-top:2rem;">
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                <a class="btn btn-outline" asp-controller="Account" asp-action="Register">إنشاء حساب مستخدم</a>
            </div>

            
        </section>
    </div>
    <script src="~/js/script.js" asp-append-version="true"></script>
    <partial name="_ToastrScripts" />
</body>
</html>