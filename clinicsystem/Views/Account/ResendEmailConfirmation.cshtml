@model clinicsystem.ViewModels.ResendEmailViewModel

<h2>Resend Email Confirmation</h2>

<form asp-action="ResendEmailConfirmation" method="post">

    <label>Email</label>

    <input asp-for="Email" />

    <span asp-validation-for="Email"></span>

    <button type="submit">
        Send Confirmation Email
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}