@model clinicsystem.ViewModels.EditStaffViewModel

@{
    ViewData["Title"] = "تعديل بيانات موظف";
}

<link rel="stylesheet" href="~/css/StyleSheet.css" />

<div class="container-fluid py-5" style="background-color: #f4f6f9; min-height: 100vh; direction: rtl;">
    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">

                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #1e3a8a, #2563eb);">
                    <div class="mb-2">
                        <i class="fas fa-user-edit fa-2x"></i>
                    </div>
                    <h3 class="fw-bold m-0 fs-4">تعديل بيانات الموظف</h3>
                    <small class="text-white-50">تحديث بيانات الحساب الحالي وتخصصه</small>
                </div>

                <div class="card-body p-4 p-sm-5" style="background-color: #ffffff;">
                    <form asp-action="EditStaff" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Role" />

                        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-4"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="FirstName" class="form-label fw-semibold text-secondary">الاسم الأول</label>
                                <input asp-for="FirstName" class="form-control px-3 py-2" style="border-radius: 8px;" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="LastName" class="form-label fw-semibold text-secondary">الاسم الأخير</label>
                                <input asp-for="LastName" class="form-control px-3 py-2" style="border-radius: 8px;" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary">البريد الإلكتروني</label>
                            <input asp-for="Email" type="email" class="form-control px-3 py-2 text-start" style="border-radius: 8px; direction: ltr;" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold text-secondary">رقم الهاتف</label>
                            <input asp-for="Phone" class="form-control px-3 py-2 text-start" style="border-radius: 8px; direction: ltr;" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        @if (Model.Role == "Doctor" || Model.Role == "طبيب")
                        {
                            <div class="mb-4">
                                <label asp-for="SpecialityId" class="form-label fw-semibold text-secondary">التخصص الطبي</label>
                                <select asp-for="SpecialityId" class="form-select px-3 py-2" style="border-radius: 8px;" asp-items="@(new SelectList(Model.Specialities, "SpecialityId", "Name"))">
                                    <option value="">-- اختر التخصص --</option>
                                </select>
                                <span asp-validation-for="SpecialityId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="row g-2 mt-2">
                            <div class="col-sm-6 order-sm-2">
                                <button type="submit" class="btn text-white w-100 py-2 fw-bold" style="background-color: #1e3a8a; border-radius: 8px;">
                                    حفظ التعديلات
                                </button>
                            </div>
                            <div class="col-sm-6 order-sm-1">
                                <a href="/Manager/DashBoard" class="btn btn-outline-secondary w-100 py-2 fw-bold" style="border-radius: 8px;">
                                    إلغاء
                                </a>
                            </div>
                        </div>

                    </form>
                </div>

            </div>

        </div>
    </div>
</div>