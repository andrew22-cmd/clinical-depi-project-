@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حجز موعد</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">🩺 <span>لوحة المستخدم</span></div>
            <ul class="nav-list">
                <li><a class="nav-link" asp-controller="Patient" asp-action="DashBoard">الرئيسية</a></li>
                <li><a class="nav-link" asp-controller="Patient" asp-action="Details">الملف الشخصي</a></li>
                <li><a class="nav-link active" asp-controller="Patient" asp-action="Reservation">حجز موعد</a></li>
            </ul>
        </aside>

        <main class="main">
            <div class="topbar">
                <div>
                    <h2>حجز موعد جديد</h2>
                    <p class="muted">اختر الطبيب لتظهر مواعيده الحقيقية فقط (أيام + ساعات الطبيب).</p>
                </div>
                <div class="actions">
                    <button class="btn btn-outline"
                            onclick="goTo('/Patient/DashBoard')">
                       الصفحة الرئيسية 
                    </button>
                </div>
            </div>

            <section class="card">
                <div class="grid-2">
                    <div>
                        <label for="specialtySelect">التخصص</label>
                        <select id="specialtySelect" class="form-control"></select>
                        <span id="specialityFeeBadge" style="display:none; margin-top:6px; background:#e8f4ff; color:#1a6fba; padding:4px 12px; border-radius:20px; font-size:0.85rem; font-weight:600; border:1px solid #b3d4f0;"></span>
                    </div>
                    <div>
                        <label interpreters="doctorSelect">الطبيب</label>
                        <select id="doctorSelect" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label>Choose Date</label>
                        <input type="date" id="reservationDate" class="form-control">
                    </div>
                </div>

                <div id="doctorAvailability" style="margin-top:1rem;"></div>
                <p id="reservationMsg" class="footer-note"></p>

                <div class="actions" style="margin-top: 1rem;">
                    <button id="bookBtn"
                            class="btn btn-primary"
                            disabled>
                        تأكيد الحجز
                    </button>
                </div>
            </section>
        </main>
    </div>

    <script src="~/js/script.js" asp-append-version="true"></script>
    <partial name="_ToastrScripts" />
</body>
</html>