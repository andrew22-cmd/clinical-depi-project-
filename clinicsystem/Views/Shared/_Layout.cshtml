<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - clinicsystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/clinicsystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- 1. تحميل jQuery الأساسي أولاً -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <!-- 2. تحميل مكتبات الـ Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- 3. تحميل باقي المكتبات -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- 4. تفعيل Toastr -->
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": true,
            "timeOut": "3500"
        };
    </script>

    @if (TempData["Success"] != null)
    {
        <script>toastr.success('@TempData["Success"]');</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>toastr.error('@TempData["Error"]');</script>
    }
    @if (TempData["Warning"] != null)
    {
        <script>toastr.warning('@TempData["Warning"]');</script>
    }
    @if (TempData["Info"] != null)
    {
        <script>toastr.info('@TempData["Info"]');</script>
    }

    <!-- 5. استدعاء السيكشن الخاص بالصفحات الفرعية -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>