@model clinicsystem.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "نسيت كلمة المرور";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="logo-mark">🔑</div>
        <h2 style="text-align:center; margin-bottom:.5rem;">نسيت كلمة المرور؟</h2>
        <p class="muted" style="text-align:center; margin-bottom:1rem;">
            أدخل بريدك الإلكتروني وسيظهر لك رابط إعادة التعيين.
        </p>

        <form class="form-grid" asp-action="ForgotPassword"
              asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="footer-note"
                 style="color:#e74c3c; margin-bottom:.5rem;"></div>

            <label asp-for="Email">البريد الإلكتروني</label>
            <input asp-for="Email" class="form-control" type="email"
                   placeholder="example@clinic.com" autocomplete="email" />
            <span asp-validation-for="Email"
                  class="footer-note" style="color:#e74c3c;"></span>

            <button class="btn btn-primary" type="submit">إرسال رابط إعادة التعيين</button>
        </form>

        <p style="text-align:center; margin-top:1rem;">
            <a asp-controller="Account" asp-action="Login">العودة لتسجيل الدخول</a>
        </p>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
