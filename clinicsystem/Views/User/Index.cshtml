@model clinicsystem.ViewModels.UserIndexViewModel
@{
    ViewData["Title"] = "إدارة المستخدمين";
    ViewData["ActivePage"] = "ManageUsers";
}
@section Sidebar {
    @await Html.PartialAsync("_ManagerSidebar")
}

<div class="topbar">
    <div>
        <h2>إدارة المستخدمين</h2>
        <p class="muted">البحث والتصفية وإدارة كل حسابات النظام.</p>
    </div>
    <div class="actions">
        <a class="btn btn-primary" asp-controller="User" asp-action="Create">إضافة مستخدم</a>
        <a class="btn btn-outline" asp-controller="Manager" asp-action="Dashboard">رجوع</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="card" style="border-right: 4px solid #2ecc71; margin-bottom:1rem;">
        <p style="margin:0; color:#2ecc71;">✔ @TempData["Success"]</p>
    </div>
}

<section class="card" style="margin-bottom:1rem;">
    <form method="get" asp-controller="User" asp-action="Index" class="form-grid"
          style="grid-template-columns: 1fr 1fr auto; align-items:end; gap:.75rem;">

        <div>
            <label for="search" class="muted" style="font-size:.85rem;">بحث بالاسم أو البريد</label>
            <input id="search" name="search" class="form-control" type="text"
                   value="@Model.SearchTerm" placeholder="ابحث هنا..." />
        </div>

        <div>
            <label for="role" class="muted" style="font-size:.85rem;">تصفية حسب الدور</label>
            <select id="role" name="role" class="form-control">
                <option value="">كل الأدوار</option>
                @foreach (var r in (IEnumerable<string>)ViewBag.Roles)
                {
                    <option value="@r" selected="@(Model.FilterRole == r ? "selected" : null)">@r</option>
                }
            </select>
        </div>

        <div class="actions" style="margin:0;">
            <button type="submit" class="btn btn-primary">بحث</button>
            <a class="btn btn-outline" asp-controller="User" asp-action="Index">إعادة تعيين</a>
        </div>
    </form>
</section>

<section class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>الاسم الكامل</th>
                    <th>البريد الإلكتروني</th>
                    <th>الهاتف</th>
                    <th>الدور</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="5" class="muted" style="text-align:center; padding:2rem;">
                            لا يوجد مستخدمون مطابقون للبحث.
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>@(string.IsNullOrEmpty(user.Phone) ? "-" : user.Phone)</td>
                        <td><span class="badge">@user.Role</span></td>
                        <td>
                            <div class="actions" style="gap:.4rem; margin:0;">
                                <a class="btn btn-outline"
                                   asp-controller="User" asp-action="Details"
                                   asp-route-id="@user.Id"
                                   style="padding:.25rem .6rem; font-size:.8rem;">تفاصيل</a>
                                <a class="btn btn-outline"
                                   asp-controller="User" asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   style="padding:.25rem .6rem; font-size:.8rem;">تعديل</a>
                                <a class="btn btn-danger"
                                   asp-controller="User" asp-action="Delete"
                                   asp-route-id="@user.Id"
                                   style="padding:.25rem .6rem; font-size:.8rem;">حذف</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination ──────────────────────────────────────────────────────── *@
    @if (Model.TotalPages > 1)
    {
        <div class="actions" style="justify-content:center; margin-top:1rem; gap:.4rem;">

            @if (Model.HasPreviousPage)
            {
                <a class="btn btn-outline"
                   asp-controller="User" asp-action="Index"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-role="@Model.FilterRole"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   style="padding:.3rem .75rem;">السابق</a>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <a class="btn @(p == Model.CurrentPage ? "btn-primary" : "btn-outline")"
                   asp-controller="User" asp-action="Index"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-role="@Model.FilterRole"
                   asp-route-page="@p"
                   style="padding:.3rem .65rem; min-width:36px; text-align:center;">@p</a>
            }

            @if (Model.HasNextPage)
            {
                <a class="btn btn-outline"
                   asp-controller="User" asp-action="Index"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-role="@Model.FilterRole"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   style="padding:.3rem .75rem;">التالي</a>
            }
        </div>

        <p class="muted" style="text-align:center; margin-top:.5rem; font-size:.82rem;">
            صفحة @Model.CurrentPage من @Model.TotalPages
        </p>
    }
</section>
