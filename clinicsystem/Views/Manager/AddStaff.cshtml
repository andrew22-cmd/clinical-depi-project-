@model clinicsystem.ViewModels.AddStaffViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" direction="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>إضافة موظف جديد</title>
    <link rel="stylesheet" href="/css/StyleSheet.css" />
    <style>
        /* تأكيد على أن التصميم يظهر في منتصف الشاشة */
        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="auth-wrapper">
        <div class="auth-card">

            <div class="logo-mark">➕</div>
            <h2 style="text-align: center; margin-bottom: 1.5rem; color: var(--text-dark);">إضافة موظف جديد</h2>

            <form asp-action="AddStaff" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

                <div class="form-grid">

                    <div>
                        <label asp-for="FirstName">الاسم الأول</label>
                        <input asp-for="FirstName" class="form-control" placeholder="الاسم الأول" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="LastName">الاسم الأخير (العائلة)</label>
                        <input asp-for="LastName" class="form-control" placeholder="الاسم الأخير" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Email">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@clinic.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Phone">رقم الهاتف</label>
                        <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Password">كلمة المرور</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Role">نوع الوظيفة</label>
                        <select asp-for="Role" id="roleSelect" class="form-control">
                            <option value="">-- اختر الوظيفة --</option>
                            <option value="Doctor">طبيب</option>
                            <option value="Secretary">سكرتارية</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div id="specialityContainer">
                        <label asp-for="SpecialityId">التخصص الطبي</label>
                        <select asp-for="SpecialityId" class="form-control" asp-items="@(new SelectList(Model.Specialities, "SpecialityId", "Name"))">
                            <option value="">-- اختر تخصص الطبيب --</option>
                        </select>
                        <span asp-validation-for="SpecialityId" class="text-danger"></span>
                    </div>

                    <div class="actions" style="margin-top: 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                        <button type="submit" class="btn btn-primary">حفظ البيانات</button>
                        <a href="/Manager/ManageUsers" class="btn btn-outline" style="text-align: center; line-height: 1.6;">إلغاء</a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // سكريبت ذكي لإخفاء وإظهار التخصص بناءً على الوظيفة المختارة علطول
        document.addEventListener("DOMContentLoaded", function () {
            const roleSelect = document.getElementById("roleSelect");
            const specialityContainer = document.getElementById("specialityContainer");

            function toggleSpeciality() {
                if (roleSelect.value === "Doctor") {
                    specialityContainer.style.display = "block";
                } else {
                    specialityContainer.style.display = "none";
                    document.querySelector("#specialityContainer select").value = "";
                }
            }

            roleSelect.addEventListener("change", toggleSpeciality);
            toggleSpeciality(); // لتشغيل الفلترة لو الصفحة حملت وكان فيه اختيار قديم
        });
    </script>
    <partial name="_ToastrScripts" />
</body>
</html>