
@using Microsoft.AspNetCore.Identity
@inject SignInManager<clinicsystem.Models.User> SignInManager
@inject UserManager<clinicsystem.Models.User> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical Clinic</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>

    @*
    Hidden element that script.js reads via readProfileFromDOM() and readRoleFromDOM().
    This replaces ALL localStorage profile/role reads.
    Rendered on every page by the server — always accurate and in sync with the session.
*@

    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        <div id="app-user-profile"
             data-name="@(currentUser?.FullName ?? string.Empty)"
             data-phone="@(currentUser?.PhoneNumber ?? string.Empty)"
             data-email="@(currentUser?.Email ?? string.Empty)"
             data-role="@(currentUser?.Role?.ToLowerInvariant() ?? "patient")"
             style="display:none;" aria-hidden="true">
        </div>
    }
    else
    {
        <div id="app-user-profile"
             data-name="" data-phone="" data-email="" data-role=""
             style="display:none;" aria-hidden="true">
        </div>
    }

    @if (IsSectionDefined("Sidebar"))
    {
        <div class="app-shell">
            <aside class="sidebar">
                @RenderSection("Sidebar", required: false)
                <partial name="_LoginPartial" />
            </aside>
            <main class="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>