@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة السكرتير</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">📋 <span>لوحة السكرتير</span></div>
            <ul class="nav-list">
                <li><a class="nav-link active" asp-controller="Secretary" asp-action="DashBoard">الحجوزات</a></li>
            </ul>
        </aside>

        <main class="main">
            <div class="topbar">
                <div>
                    <h2>إدارة الحجوزات</h2>
                    <p class="muted">كل حجوزات المرضى الأونلاين تظهر هنا تلقائياً + إمكانية الحجز اليدوي.</p>
                </div>
                <a href="/Account/Logout" class="btn btn-outline">تسجيل الخروج</a>
            </div>

            <!-- بطاقات الإحصائيات -->
            <section class="grid-4">
                <div class="card">
                    <h4>إجمالي الحجوزات</h4>
                    <div class="stat" id="reservationCounter">0</div>
                </div>
                <div class="card">
                    <h4>حجوزات اليوم</h4>
                    <div class="stat" id="todayReservationCounter">0</div>
                </div>
            </section>

            <!-- قائمة الأسعار -->
            <section class="card" style="margin-top:1rem;">
                <h3>💰 قائمة أسعار الكشف</h3>
                <p class="muted">أسعار الكشف حسب التخصص الطبي</p>
                <div class="table-wrap" style="margin-top: 1rem;">
                    <table>
                        <thead>
                            <tr>
                                <th>التخصص</th>
                                <th>سعر الكشف</th>
                            </tr>
                        </thead>
                        <tbody id="secPriceListBody">
                            <tr><td colspan="2" class="muted" style="text-align:center;">جاري التحميل...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- فورم الحجز + تقويم الأطباء -->
            <section class="grid-2" style="margin-top:1rem;">
                <div class="card">
                    <h3>➕ إضافة حجز جديد</h3>
                    <form class="form-grid" onsubmit="createSecretaryReservation(event)">
                        <label for="secPatientName">اسم المريض</label>
                        <input id="secPatientName" class="form-control" type="text" placeholder="أدخل اسم المريض" required>

                        <label for="secPatientPhone">رقم الهاتف</label>
                        <input id="secPatientPhone" class="form-control" type="tel" placeholder="01xxxxxxxxx" required>

                        <label>التخصص</label>
                        <select id="secSpeciality" class="form-control">
                            <option value="">اختر التخصص</option>
                        </select>

                        <label>الطبيب</label>
                        <select id="secDoctor" class="form-control">
                            <option value="">اختر الطبيب</option>
                        </select>

                        <label for="secReservationDate">تاريخ الحجز</label>
                        <input type="date" id="secReservationDate" class="form-control">

                        <div id="secretarySlots" style="margin-top:12px;"></div>

                        <button type="submit" class="btn btn-primary" style="margin-top:8px;">إضافة الحجز</button>
                    </form>
                    <p id="secMsg" class="footer-note"></p>
                </div>

                <div class="card">
                    <h3>📅 مواعيد الأطباء</h3>
                    <div id="doctorSchedulesGrid" class="calendar-grid" style="margin-top:.8rem;"></div>
                </div>
            </section>

            <!-- جدول الحجوزات الكاملة -->
            <section class="card" style="margin-top:1rem;">
                <h3>📋 قائمة الحجوزات (أونلاين + يدوي)</h3>
                <div class="table-wrap" style="margin-top:1rem;">
                    <table>
                        <thead>
                            <tr>
                                <th>المريض</th>
                                <th>الهاتف</th>
                                <th>الطبيب</th>
                                <th>اليوم</th>
                                <th>الوقت</th>
                                <th>المصدر</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="bookingListBody"></tbody>
                    </table>
                </div>
            </section>

        </main>
    </div>

    <script src="~/js/script.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadSecPriceList();
        });

        function loadSecPriceList() {
            fetch('/Secretary/GetSpecialities')
                .then(r => r.json())
                .then(res => {
                    const tbody = document.getElementById('secPriceListBody');
                    if (tbody) {
                        tbody.innerHTML = '';
                        if (res.success && res.data && res.data.length > 0) {
                            res.data.forEach(item => {
                                tbody.innerHTML += `
                                    <tr>
                                        <td style="font-weight:500;">${item.name === 'General' ? 'عام' : item.name}</td>
                                        <td style="color:#10b981; font-weight:bold;">${item.fee} EGP</td>
                                    </tr>
                                `;
                            });
                        } else {
                            tbody.innerHTML = '<tr><td colspan="2" class="muted" style="text-align:center;">لا توجد بيانات حالياً</td></tr>';
                        }
                    }
                })
                .catch(err => console.error('Error fetching prices', err));
        }
    </script>
    <partial name="_ToastrScripts" />
</body>
</html>