@model clinicsystem.ViewModels.UserViewModel
@{
    ViewData["Title"] = "تعديل بيانات المستخدم";
}
@section Sidebar {
    @await Html.PartialAsync("_ManagerSidebar")
}

<div class="topbar">
    <h2>تعديل بيانات المستخدم</h2>
    <div class="actions">
        <a class="btn btn-outline" asp-controller="User" asp-action="Index">رجوع للقائمة</a>
    </div>
</div>

<section class="card" style="max-width:560px;">
    <form class="form-grid" asp-action="Edit" asp-controller="User" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="footer-note"
             style="color:#e74c3c; margin-bottom:.5rem;"></div>

        <label asp-for="FirstName">الاسم الأول</label>
        <input asp-for="FirstName" class="form-control" type="text" />
        <span asp-validation-for="FirstName" class="footer-note" style="color:#e74c3c;"></span>

        <label asp-for="LastName">اسم العائلة</label>
        <input asp-for="LastName" class="form-control" type="text" />
        <span asp-validation-for="LastName" class="footer-note" style="color:#e74c3c;"></span>

        <label asp-for="Email">البريد الإلكتروني</label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="footer-note" style="color:#e74c3c;"></span>

        <label asp-for="Phone">رقم الهاتف</label>
        <input asp-for="Phone" class="form-control" type="text" />
        <span asp-validation-for="Phone" class="footer-note" style="color:#e74c3c;"></span>

        <label asp-for="Role">الدور</label>
        <select asp-for="Role" asp-items="ViewBag.Roles" class="form-control"></select>
        <span asp-validation-for="Role" class="footer-note" style="color:#e74c3c;"></span>

        <label asp-for="Password">
            كلمة المرور الجديدة
            <span class="muted" style="font-size:.8rem;">(اتركها فارغة للإبقاء على الحالية)</span>
        </label>
        <input asp-for="Password" class="form-control" type="password"
               placeholder="••••••••" autocomplete="new-password" />
        <span asp-validation-for="Password" class="footer-note" style="color:#e74c3c;"></span>

        <label asp-for="ConfirmPassword">تأكيد كلمة المرور الجديدة</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password"
               placeholder="••••••••" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="footer-note" style="color:#e74c3c;"></span>

        <div class="actions">
            <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
            <a class="btn btn-outline"
               asp-controller="User" asp-action="Details"
               asp-route-id="@Model.Id">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
